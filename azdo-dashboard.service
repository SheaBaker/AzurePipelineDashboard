[Unit]
Description=Azure Pipelines live dashboard
After=network-online.target
Wants=network-online.target

[Service]
# Set to the account that owns /opt/azdo-dashboard (see README, step 5)
User=YOUR_USER
WorkingDirectory=/opt/azdo-dashboard
EnvironmentFile=/opt/azdo-dashboard/azdo.env
# One worker only: each worker would start its own poller thread
ExecStart=/opt/azdo-dashboard/venv/bin/gunicorn -w 1 --threads 4 -b 0.0.0.0:5050 app:app
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
